{
  "name": "survey-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:worker": "wrangler dev",
    "dev:web": "cd web && npx vite --port 3000",
    "build:web": "cd web && npx vite build",
    "deploy": "wrangler deploy --no-bundle",
    "deploy:pages": "wrangler pages deploy web/dist --project-name survey-system",
    "init-admin": "curl https://survey-system.workers.dev/api/init"
  },
  "dependencies": {
    "hono": "^4.4.0"
  },
  "devDependencies": {
    "wrangler": "^3.60.0",
    "@cloudflare/workers-types": "^4.20240620.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.23.0",
    "recharts": "^2.12.0",
    "concurrently": "^8.2.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.8.0",
    "unpdf": "^0.14.0"
  }
}
